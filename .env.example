# Application
APP_BASE_URL=https://catalyst-procurement-os-demo-6jouh.ondigitalocean.app
DEMO_AUTH_BYPASS=0
ACTION_CONFIRMATION_SECRET=
CATALYST_ENVIRONMENT_KIND=development_preview
CATALYST_RELEASE_CHANNEL=development-preview
CATALYST_SYNTHETIC_ONLY=1
CATALYST_PRESENTER_SIMULATION=1
CATALYST_RESET_ENABLED=1
CATALYST_OPERATIONS_PROBE_SECRET=

# Supabase Auth (PKCE + cookie SSR). These are runtime-only so one signed
# image can be promoted across isolated Supabase projects.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy development-preview compatibility only. Do not configure these on
# sales-demo or secure-pilot images.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enterprise SSO is server-selected at runtime; never bake it into the image.
CATALYST_SSO_ENABLED=0

# Server-only. Never expose this as NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
CATALYST_AI_MODE=auto
OPENAI_LUNA_INPUT_USD_PER_1M=0.25
OPENAI_LUNA_OUTPUT_USD_PER_1M=2
OPENAI_TERRA_INPUT_USD_PER_1M=1.75
OPENAI_TERRA_OUTPUT_USD_PER_1M=14
OPENAI_SOL_INPUT_USD_PER_1M=4
OPENAI_SOL_OUTPUT_USD_PER_1M=32

# ElevenLabs CATE agent
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_ESTIMATED_USD_PER_MINUTE=0.10

# Google OAuth. TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
